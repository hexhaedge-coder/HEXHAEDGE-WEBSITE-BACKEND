# HexhaEdge API settings. On Render: put these in the "hexhaedge-shared" Environment Group.
# Locally: copy to .env (never committed) and run `npm run dev`.
# Leave a provider empty (or write: unset) until you have it; it is skipped and logged.

# ---- Firebase (server side) ----
# Firebase console → Project settings → Service accounts → Generate new private key.
# Base64 it on one line (macOS/Linux: base64 -w0 key.json) and paste here. Never commit the key.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=hexhaedge-website.firebasestorage.app

# ---- Addresses ----
APP_URL=https://hexhaedge-website.hexhaedge.workers.dev
PUBLIC_API_URL=https://hexhaedge-api.onrender.com
# Website origins allowed to call the API (comma separated, no trailing slash)
ALLOWED_ORIGINS=https://hexhaedge-website.hexhaedge.workers.dev,http://localhost:8765

# ---- Security ----
REQUIRE_STAFF_MFA=true
ENFORCE_APP_CHECK=false
# Long random string; lets an outside scheduler call POST /internal/tick
CRON_TOKEN=

# ---- M-Pesa (Daraja). Sandbox defaults shown. Production needs a Safaricom-issued Paybill or Till. ----
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_TILL_OR_PAYBILL=paybill
MPESA_PARTY_B=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Long random string; it is part of the callback URLs Safaricom calls
MPESA_CALLBACK_TOKEN=

# ---- SMS (Africa's Talking) ----
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ---- WhatsApp Business Platform (template "hx_notice" with one body variable) ----
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=HexhaEdge <no-reply@your-domain.co.ke>

# ---- Cloudinary (profile photos only). Uploads are signed by this server;
# no unsigned upload preset is used or needed. ----
CLOUDINARY_CLOUD_NAME=btzphyp2
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Where failure alerts go ----
ADMIN_ALERT_PHONE=
ADMIN_ALERT_EMAIL=
